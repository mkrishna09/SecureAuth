{
  "compilerOptions": {
    "target": "ES2022",

    "module": "NodeNext",

    "moduleResolution": "NodeNext",

    "outDir": "./dist",

    "rootDir": "./src",

    "strict": true,

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "isolatedModules": true,

    "noUncheckedIndexedAccess": true,

    "exactOptionalPropertyTypes": true,

    "sourceMap": true
  },

  "include": ["src"],

  "exclude": [
    "node_modules",
    "dist"
  ]
}