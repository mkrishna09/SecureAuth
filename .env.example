# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secureauth

# JWT
JWT_ACCESS_SECRET=replace_with_32_plus_character_secret
JWT_REFRESH_SECRET=replace_with_32_plus_character_secret

# Mailtrap
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mailtrap_username
MAIL_PASS=your_mailtrap_password
MAIL_FROM="SecureAuth <noreply@secureauth.dev>"